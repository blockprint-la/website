---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { gallery } from "../data/gallery";

// Full photo gallery from the 2026 day-of shoot — every select from both
// shooters, in shoot order. Thumbs (520px) load lazily in the masonry
// grid; clicking opens a lightbox that swaps in the 1600px full, with
// arrow-key / swipe-adjacent prev-next and Esc to close. No libraries —
// one inline script drives the overlay.
---

<Layout
  title="Blockprint — The Full Gallery"
  description="Every photo from Blockprint year one on Abbot Kinney Blvd. August 22, 2026, Venice, California."
>
  <main class="px-5 md:px-10 py-12 md:py-16">
    <div class="max-w-7xl mx-auto">
      <!-- Wordmark links back home -->
      <a href="/" class="block w-fit mx-auto mb-10 md:mb-12" aria-label="Back to Blockprint home">
        <img src="/brand/wordmark.png" alt="Blockprint" width="1010" height="152" class="w-full max-w-[420px]" />
      </a>

      <header class="text-center mb-10 md:mb-14">
        <h1
          class="block-print font-[var(--font-display)] uppercase font-black leading-[0.85] text-[clamp(2.5rem,8vw,6rem)] mb-4"
          data-ink="pink"
          data-ghost
          style="--ghost: var(--color-bp-cyan);"
        >
          The Full Gallery
        </h1>
        <p class="text-xs md:text-sm uppercase tracking-[0.3em] opacity-80">
          August 22, 2026 · Abbot Kinney Blvd · {gallery.length} photos
        </p>
      </header>

      <div class="gallery-grid">
        {gallery.map((p, i) => (
          <button
            type="button"
            class="gallery-item"
            data-index={i}
            aria-label={`Open photo ${i + 1} of ${gallery.length}`}
          >
            <img
              src={`/photos/gallery/thumb/${p.id}.jpg`}
              width={p.w}
              height={p.h}
              alt={`Blockprint 2026 photo ${i + 1}`}
              loading="lazy"
              decoding="async"
              class="block w-full h-auto"
            />
          </button>
        ))}
      </div>
    </div>
  </main>

  <!-- Lightbox overlay -->
  <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-label="Photo viewer">
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Close">✕</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Previous photo">←</button>
    <img id="lightbox-img" alt="" />
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Next photo">→</button>
    <p id="lightbox-count" class="lb-count"></p>
  </div>

  <Footer />
</Layout>

<style>
  .gallery-grid {
    columns: 2;
    column-gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .gallery-grid { columns: 3; column-gap: 1rem; }
  }
  @media (min-width: 1200px) {
    .gallery-grid { columns: 4; }
  }
  .gallery-item {
    display: block;
    width: 100%;
    break-inside: avoid;
    margin: 0 0 0.75rem;
    padding: 0;
    border: none;
    background: var(--color-paper);
    cursor: zoom-in;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  @media (min-width: 768px) {
    .gallery-item { margin-bottom: 1rem; }
  }
  .gallery-item:hover {
    transform: translate(2px, -2px);
    box-shadow: -4px 4px 0 var(--color-bp-cyan);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(21, 21, 21, 0.94);
  }
  .lightbox[data-open] { display: flex; }
  .lightbox img {
    max-width: 92vw;
    max-height: 86svh;
    object-fit: contain;
    box-shadow: -6px 6px 0 var(--color-bp-pink);
    background: var(--color-ink);
  }
  .lb-btn {
    position: absolute;
    z-index: 101;
    background: var(--color-paper);
    color: var(--color-ink);
    border: none;
    width: 44px;
    height: 44px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: -3px 3px 0 var(--color-bp-cyan);
  }
  .lb-btn:hover { background: var(--color-bp-pink); color: var(--color-paper); }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-count {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-paper);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.8;
  }
</style>

<script>
  import { gallery } from "../data/gallery";

  const box = document.getElementById("lightbox")!;
  const img = document.getElementById("lightbox-img") as HTMLImageElement;
  const count = document.getElementById("lightbox-count")!;
  let current = -1;

  const show = (i: number) => {
    current = (i + gallery.length) % gallery.length;
    img.src = `/photos/gallery/full/${gallery[current].id}.jpg`;
    img.alt = `Blockprint 2026 photo ${current + 1}`;
    count.textContent = `${current + 1} / ${gallery.length}`;
    box.setAttribute("data-open", "true");
    box.setAttribute("aria-hidden", "false");
    document.documentElement.style.overflow = "hidden";
    // Warm the neighbors so prev/next feels instant
    for (const n of [current + 1, current - 1]) {
      new Image().src = `/photos/gallery/full/${gallery[(n + gallery.length) % gallery.length].id}.jpg`;
    }
  };
  const close = () => {
    box.removeAttribute("data-open");
    box.setAttribute("aria-hidden", "true");
    img.src = "";
    current = -1;
    document.documentElement.style.overflow = "";
  };

  document.querySelectorAll<HTMLButtonElement>(".gallery-item").forEach((b) =>
    b.addEventListener("click", () => show(Number(b.dataset.index)))
  );
  box.querySelector("[data-lb-close]")!.addEventListener("click", close);
  box.querySelector("[data-lb-prev]")!.addEventListener("click", () => show(current - 1));
  box.querySelector("[data-lb-next]")!.addEventListener("click", () => show(current + 1));
  box.addEventListener("click", (e) => {
    if (e.target === box) close();
  });
  document.addEventListener("keydown", (e) => {
    if (current < 0) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowLeft") show(current - 1);
    else if (e.key === "ArrowRight") show(current + 1);
  });
</script>
