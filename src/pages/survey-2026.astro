---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

// ---------------------------------------------------------------------------
// Post-event fan survey — built off the 2026-08-25 Crowd Control sync.
//
// Year-scoped URL (/survey-2026) so future years get their own page and
// sheet; /survey redirects here (astro.config redirects) until 2027's
// survey takes the alias over.
//
// The question set is deliberately light-touch and fully qualitative: every
// question optional (a submit just needs at least one answer), big open text
// boxes up top (Kiersten's direction: give people blank space to say
// whatever they want), and an email + waitlist capture at the end so the
// survey doubles as the 2027 waitlist funnel.
//
// Submits JSON to a Google Apps Script Web App (site.surveyFormUrl) which
// appends a row to "Website Submissions — 2026 Fan Survey" in the Stereo
// Punks Drive. Same transport as the Partners form: Content-Type text/plain
// dodges the CORS preflight Apps Script Web Apps can't answer; the handler
// does JSON.parse(e.postData.contents). Honeypot "website" field silently
// 200s server-side without writing a row.
//
// Distribution attribution: ?src=sms / ?src=email etc. is folded into the
// `source` column so blast performance is visible per channel in the sheet.
//
// Hive (brand 135484): submits that include an email also fire-and-forget
// into Hive — emailSignup + "2026 Survey Respondents" static segment, plus
// "2027 Waitlist" when the waitlist box is checked. The sheet write is the
// critical path; Hive failures never block the success state (and the SDK
// is domain-whitelisted, so localhost/preview submits silently skip Hive —
// verify segment membership on the live domain, not in dev). The standalone
// waitlist page should push into the same "2027 Waitlist" segment.
// ---------------------------------------------------------------------------

// Revised 8/26 off Evan's survey-methodology pass (Plaud recording):
// neutral anchors on the overall rating, rating grid + timing question cut
// (fatigue / unqualified-respondent), local-business spend range added,
// "No" added to coming-back, and the contact/waitlist block only reveals
// on Absolutely/Probably so asking for contact info doesn't suppress
// negative feedback.

const spendOptions = [
  "Nothing",
  "Under $50",
  "$50–$150",
  "$150–$300",
  "$300+",
  "Can't remember",
];

const heardOptions = [
  "Instagram / TikTok",
  "An ad",
  "A friend",
  "Walked by",
  "An artist's post",
  "Email or text",
  "Somewhere else",
];

const returningOptions = ["Absolutely", "Probably", "Not sure", "No"];
---

<Layout
  title="How Was the Block? — Blockprint"
  description="Blockprint year one is in the books. Tell us what worked, what didn't, and who you want on the block next year."
>
  <main class="px-5 md:px-10 py-14 md:py-20">
    <div class="max-w-2xl mx-auto">
      <!-- Wordmark links back home -->
      <a href="/" class="block mb-12 md:mb-16" aria-label="Back to Blockprint home">
        <img
          src="/brand/wordmark.png"
          alt="Blockprint"
          width="1010"
          height="152"
          class="w-full max-w-[300px] mx-auto"
        />
      </a>

      <header id="survey-header" class="text-center mb-12 md:mb-16">
        <h1
          class="block-print font-[var(--font-display)] uppercase font-black leading-[0.9] text-[clamp(2.4rem,9vw,4.5rem)]"
          data-ink="pink"
          data-ghost
        >
          How Was<br />the Block?
        </h1>
        <p class="text-base md:text-lg leading-relaxed opacity-90 max-w-xl mx-auto mt-6">
          Year one is in the books. Year two gets built off what you tell us
          — the good, the bad, all of it. Takes two minutes, goes straight to
          the team.
        </p>
      </header>

      <form id="survey-form" class="survey-form" data-endpoint={site.surveyFormUrl} novalidate>
        <!-- 01 · Do differently — straight into the open-ended (the overall
             rating was cut 8/26: fully qualitative, per Evan/Jake) -->
        <section class="survey-block" aria-labelledby="q-improve">
          <span class="tape-label text-sm">01</span>
          <h2 id="q-improve" class="survey-q">What should we do differently next year?</h2>
          <textarea
            id="survey-improve"
            name="improve"
            rows="5"
            maxlength="2000"
            class="survey-textarea"
            placeholder="Be honest. This is the whole point."
            aria-labelledby="q-improve"></textarea>
        </section>

        <!-- 02 · Loved -->
        <section class="survey-block" aria-labelledby="q-loved">
          <span class="tape-label text-sm tape-label--cyan">02</span>
          <h2 id="q-loved" class="survey-q">What did you love?</h2>
          <textarea
            id="survey-loved"
            name="loved"
            rows="4"
            maxlength="2000"
            class="survey-textarea"
            placeholder="Brag on us a little."
            aria-labelledby="q-loved"></textarea>
        </section>

        <!-- 03 · Dream bookings -->
        <section class="survey-block" aria-labelledby="q-lineup">
          <span class="tape-label text-sm tape-label--navy">03</span>
          <h2 id="q-lineup" class="survey-q">Who should play next year?</h2>
          <input
            id="survey-lineup"
            name="lineup"
            type="text"
            maxlength="300"
            class="survey-input"
            placeholder="Dream bookings. Go big."
            aria-labelledby="q-lineup"
          />
        </section>

        <!-- 04 · Local spend — economic-impact data for the neighborhood case -->
        <section class="survey-block" aria-labelledby="q-spend">
          <span class="tape-label text-sm">04</span>
          <h2 id="q-spend" class="survey-q">How much did you spend on the block?</h2>
          <p class="survey-hint">
            Outside the event — shops, restaurants, and bars in the neighborhood
            that day. Rough guess is perfect.
          </p>
          <div class="chip-row" role="radiogroup" aria-labelledby="q-spend" data-chips="spend" data-mode="single">
            {spendOptions.map((s) => (
              <button type="button" class="chip" role="radio" aria-checked="false" data-value={s}>
                {s}
              </button>
            ))}
          </div>
        </section>

        <!-- 05 · Heard via -->
        <section class="survey-block" aria-labelledby="q-heard">
          <span class="tape-label text-sm tape-label--cyan">05</span>
          <h2 id="q-heard" class="survey-q">How'd you hear about this year?</h2>
          <p class="survey-hint">Pick as many as apply.</p>
          <div class="chip-row" role="group" aria-labelledby="q-heard" data-chips="heard" data-mode="multi">
            {heardOptions.map((h) => (
              <button type="button" class="chip" role="checkbox" aria-checked="false" data-value={h}>
                {h}
              </button>
            ))}
          </div>
        </section>

        <!-- 06 · Coming back + waitlist (contact only reveals on a yes-ish answer) -->
        <section class="survey-block" aria-labelledby="q-returning">
          <span class="tape-label text-sm tape-label--navy">06</span>
          <h2 id="q-returning" class="survey-q">Are you coming back?</h2>
          <div class="chip-row" role="radiogroup" aria-labelledby="q-returning" data-chips="returning" data-mode="single">
            {returningOptions.map((r) => (
              <button type="button" class="chip" role="radio" aria-checked="false" data-value={r}>
                {r}
              </button>
            ))}
          </div>

          <!-- Hidden until "Absolutely" or "Probably" — asking everyone for
               contact info suppresses negative feedback (Evan, 8/26), and
               the people who'd join a waitlist are the yes-ish ones anyway. -->
          <div id="survey-contact" class="survey-contact" hidden>
            <label for="survey-email" class="sr-only">Email address</label>
            <input
              id="survey-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              maxlength="200"
              class="survey-input"
              placeholder="Email address"
            />
            <label for="survey-phone" class="sr-only">Mobile number (optional)</label>
            <input
              id="survey-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              maxlength="40"
              class="survey-input"
              placeholder="Mobile number (optional)"
            />
            <label class="waitlist-check">
              <input id="survey-waitlist" type="checkbox" checked />
              <span>Put me on the 2027 waitlist — first word when tickets drop</span>
            </label>
          </div>
        </section>

        <!-- Honeypot — bots fill it, humans never see it. Server writes
             nothing when populated but still answers ok:true. -->
        <div class="survey-trap" aria-hidden="true">
          <label for="survey-website">Website</label>
          <input id="survey-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="survey-actions">
          <button
            type="submit"
            class="survey-btn bg-bp-pink text-paper px-10 py-4 text-sm uppercase tracking-[0.25em] font-bold"
            style="filter: url(#ink-bleed-soft); box-shadow: -3px 3px 0 var(--color-bp-cyan);"
          >
            <span data-label-idle>Send It</span>
            <span data-label-loading hidden>Sending…</span>
          </button>
          <p data-status role="status" aria-live="polite" class="survey-status"></p>
          <p class="survey-fine">
            Every response goes into making next year better. Contact details are
            only used for Blockprint updates — see our
            <a href="/privacy-policy">Privacy Policy</a>.
          </p>
        </div>
      </form>

      <!-- Success state — swapped in for the form after a good submit -->
      <div id="survey-done" class="text-center py-16" hidden>
        <h2
          class="block-print font-[var(--font-display)] uppercase font-black leading-[0.9] text-[clamp(2rem,8vw,3.5rem)]"
          data-ink="pink"
          data-ghost
        >
          Thank You,<br />Venice
        </h2>
        <p class="text-base md:text-lg opacity-90 max-w-md mx-auto mt-6">
          Got it — and we mean it, thank you. Year two gets built off this.
          See you on the block.
        </p>
        <a href="/" class="inline-block mt-10 text-sm uppercase tracking-[0.25em] font-bold underline underline-offset-4 hover:text-bp-pink">
          Back to Blockprint
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .survey-form { display: flex; flex-direction: column; gap: 3.5rem; }

  .survey-block { display: flex; flex-direction: column; }
  .survey-block .tape-label { align-self: flex-start; margin-bottom: 0.9rem; }

  .survey-q {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 900;
    line-height: 1.05;
    font-size: clamp(1.35rem, 4.5vw, 1.9rem);
    margin-bottom: 0.75rem;
  }
  .survey-hint {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: -0.35rem 0 0.9rem;
  }

  /* ---------- Text inputs ---------- */
  .survey-textarea,
  .survey-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.45);
    border: 2px solid var(--color-ink);
    padding: 0.85rem 1rem;
    font-size: 1rem;
    line-height: 1.5;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    resize: vertical;
  }
  .survey-textarea:focus,
  .survey-input:focus {
    border-color: var(--color-bp-pink);
    box-shadow: -3px 3px 0 var(--color-bp-cyan);
  }
  .survey-textarea::placeholder,
  .survey-input::placeholder { color: rgba(21, 21, 21, 0.4); }

  /* ---------- Choice chips ---------- */
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    appearance: none;
    background: transparent;
    border: 2px solid var(--color-ink);
    color: var(--color-ink);
    padding: 0.55rem 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.08s ease;
  }
  .chip:hover { transform: translateY(-2px); }
  .chip[aria-checked="true"] {
    background: var(--color-bp-pink);
    border-color: var(--color-bp-pink);
    color: var(--color-paper);
    box-shadow: -2px 2px 0 var(--color-bp-cyan);
  }

  /* ---------- Contact + waitlist ---------- */
  .survey-contact {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }
  .waitlist-check {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .waitlist-check input {
    appearance: none;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    border: 2px solid var(--color-ink);
    background: transparent;
    cursor: pointer;
    display: grid;
    place-content: center;
  }
  .waitlist-check input:checked {
    background: var(--color-bp-pink);
    border-color: var(--color-bp-pink);
    box-shadow: -2px 2px 0 var(--color-bp-cyan);
  }
  .waitlist-check input:checked::before {
    content: "✕";
    color: var(--color-paper);
    font-weight: 900;
    font-size: 0.8rem;
    line-height: 1;
  }

  /* ---------- Honeypot ---------- */
  .survey-trap {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ---------- Actions ---------- */
  .survey-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }
  .survey-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .survey-status {
    min-height: 1.1rem;
    font-size: 0.85rem;
    text-align: center;
  }
  .survey-fine {
    max-width: 44ch;
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgba(21, 21, 21, 0.72);
    text-align: center;
  }
  .survey-fine a { text-decoration: underline; text-underline-offset: 2px; }
</style>

<!-- Hive SDK loader (brand 135484) — same queueing-aware IIFE as the
     Newsletter component: calls made before the SDK finishes loading are
     buffered and replayed, and the __hiveInited guard keeps init single
     if another component on the page also loads it. -->
<script is:inline>
  (function (h, i, v, e, s, d, k) {
    h.HiveSDKObject = s;
    h[s] =
      h[s] ||
      function () {
        (h[s].q = h[s].q || []).push(arguments);
      };
    d = i.createElement(v);
    k = i.getElementsByTagName(v)[0];
    d.async = 1;
    d.id = s;
    d.src = e + "?r=" + parseInt(new Date() / 60000);
    k.parentNode.insertBefore(d, k);
  })(
    window,
    document,
    "script",
    "https://cdn-prod.hive.co/static/js/sdk-loader.js",
    "HIVE_SDK"
  );
  if (!window.__hiveInited) {
    HIVE_SDK("init", 135484);
    window.__hiveInited = true;
  }
</script>

<script is:inline>
  (function () {
    const form = document.getElementById("survey-form");
    if (!form) return;

    const endpoint = form.dataset.endpoint;
    const done = document.getElementById("survey-done");
    const button = form.querySelector("button[type=submit]");
    const labelIdle = button.querySelector("[data-label-idle]");
    const labelLoading = button.querySelector("[data-label-loading]");
    const status = form.querySelector("[data-status]");
    const emailInput = document.getElementById("survey-email");
    const waitlistInput = document.getElementById("survey-waitlist");

    const setLoading = (loading) => {
      button.disabled = loading;
      labelIdle.hidden = loading;
      labelLoading.hidden = !loading;
    };
    const setStatus = (msg, tone) => {
      status.textContent = msg;
      status.style.color =
        tone === "ok"
          ? "var(--color-bp-navy)"
          : tone === "err"
            ? "var(--color-bp-pink-deep)"
            : "";
    };

    // Rating groups + single-select chip groups behave like radios;
    // multi-select chip groups toggle. State lives in the aria-checked
    // attribute so the CSS and the payload read the same source of truth.
    const wireGroup = (group, multi) => {
      const buttons = group.querySelectorAll("[data-value]");
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          if (multi) {
            const on = btn.getAttribute("aria-checked") === "true";
            btn.setAttribute("aria-checked", String(!on));
          } else {
            const wasOn = btn.getAttribute("aria-checked") === "true";
            buttons.forEach((b) => b.setAttribute("aria-checked", "false"));
            // Clicking the selected value again clears it — everything
            // except the overall rating is optional, so allow undo.
            if (!wasOn) btn.setAttribute("aria-checked", "true");
          }
        });
      });
    };
    form.querySelectorAll('[data-chips][data-mode="single"]').forEach((g) => wireGroup(g, false));
    form.querySelectorAll('[data-chips][data-mode="multi"]').forEach((g) => wireGroup(g, true));

    // Contact + waitlist only reveal on a yes-ish "coming back" answer.
    // Runs on bubble after wireGroup's own click handler has updated state.
    const contactBlock = document.getElementById("survey-contact");
    form.querySelector('[data-chips="returning"]').addEventListener("click", () => {
      const picked = readSingle("returning");
      contactBlock.hidden = picked !== "Absolutely" && picked !== "Probably";
    });

    const readSingle = (name) => {
      const el = form.querySelector(
        `[data-rating="${name}"] [aria-checked="true"], [data-chips="${name}"] [aria-checked="true"]`
      );
      return el ? el.dataset.value : "";
    };
    const readMulti = (name) => {
      return Array.from(
        form.querySelectorAll(`[data-chips="${name}"] [aria-checked="true"]`)
      )
        .map((el) => el.dataset.value)
        .join(", ");
    };

    // Distribution attribution: blasts link with ?src=sms / ?src=email etc.
    const params = new URLSearchParams(window.location.search);
    const src = params.get("src") || params.get("utm_source") || "";
    const source = "blockprint.la/survey-2026" + (src ? "?src=" + src : "");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Everything is optional, but an entirely blank submit is noise.
      const improve = document.getElementById("survey-improve").value.trim();
      const loved = document.getElementById("survey-loved").value.trim();
      const lineup = document.getElementById("survey-lineup").value.trim();
      const anyAnswer =
        improve || loved || lineup ||
        readSingle("spend") || readMulti("heard") || readSingle("returning");
      if (!anyAnswer) {
        setStatus("Give us at least one answer first.", "err");
        return;
      }

      // Contact fields only count when the block is revealed (yes-ish answer).
      const contactOpen = !document.getElementById("survey-contact").hidden;
      const email = contactOpen ? emailInput.value.trim() : "";
      if (contactOpen) {
        if (email && email.indexOf("@") < 1) {
          setStatus("That email doesn't look right — mind checking it?", "err");
          emailInput.focus();
          return;
        }
        if (waitlistInput.checked && !email) {
          setStatus("Drop your email so we can actually put you on the list.", "err");
          emailInput.focus();
          return;
        }
      }

      if (!endpoint) {
        console.error("[survey] no endpoint configured");
        setStatus("Survey isn't live yet — please try again later.", "err");
        return;
      }

      const payload = {
        improve: improve,
        loved: loved,
        lineup: lineup,
        spend: readSingle("spend"),
        heard: readMulti("heard"),
        returning: readSingle("returning"),
        email: email,
        phone: contactOpen ? document.getElementById("survey-phone").value.trim() : "",
        waitlist: contactOpen && waitlistInput.checked ? "yes" : "",
        website: document.getElementById("survey-website").value,
        source: source,
      };

      setLoading(true);
      setStatus("");

      try {
        // text/plain avoids the CORS preflight Apps Script can't answer.
        // Body is still JSON — doPost does JSON.parse(e.postData.contents).
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload),
        });

        const text = await res.text();
        let data = null;
        try { data = JSON.parse(text); } catch (_) { /* non-JSON response */ }

        if (res.ok && data && data.ok) {
          // Fire-and-forget Hive adds — the sheet row is already saved, so
          // Hive errors only log; they never block the thank-you state.
          if (email && typeof window.HIVE_SDK === "function") {
            try {
              window.HIVE_SDK(
                "emailSignup",
                { email: email, didOptIn: true },
                function () {
                  window.HIVE_SDK("addToSegment", "2026 Survey Respondents",
                    function () {},
                    function (err) { console.error("[survey] hive respondents segment failed", err); });
                  if (payload.waitlist === "yes") {
                    window.HIVE_SDK("addToSegment", "2027 Waitlist",
                      function () {},
                      function (err) { console.error("[survey] hive waitlist segment failed", err); });
                  }
                },
                function (err) { console.error("[survey] hive emailSignup failed", err); }
              );
            } catch (hiveErr) {
              console.error("[survey] hive error", hiveErr);
            }
          }
          form.hidden = true;
          document.getElementById("survey-header").hidden = true;
          done.hidden = false;
          window.scrollTo({ top: 0, behavior: "smooth" });
          if (typeof gtag === "function") gtag("event", "survey_submit");
        } else {
          console.error("[survey] submit failed", { status: res.status, body: text });
          setStatus("Could not submit — please try again, or email us directly.", "err");
          setLoading(false);
        }
      } catch (err) {
        console.error("[survey] network error", err);
        setStatus("Network error — please try again, or email us directly.", "err");
        setLoading(false);
      }
    });
  })();
</script>
