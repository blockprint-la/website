---
// Inline SVG filters used by .ink-stamp and .ink-stamp-soft.
// Rendered once at the top of <body> so all elements can reference them by id.
---

<svg
  width="0"
  height="0"
  aria-hidden="true"
  style="position:absolute;width:0;height:0;overflow:hidden"
>
  <defs>
    <!-- Strong ink-bleed: chunky displacement for hero stamp lettering -->
    <filter id="ink-bleed" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.02 0.04" numOctaves="2" seed="3" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.5" xChannelSelector="R" yChannelSelector="G"/>
    </filter>

    <!-- Soft ink-bleed: lighter chew for body-size or rotated tape labels -->
    <filter id="ink-bleed-soft" x="-3%" y="-3%" width="106%" height="106%">
      <feTurbulence type="fractalNoise" baseFrequency="0.04 0.08" numOctaves="2" seed="7" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.4" xChannelSelector="R" yChannelSelector="G"/>
    </filter>

    <!-- Rough edge: chunky torn/jagged displacement for thick frame brackets.
         Generous region so displaced pixels aren't clipped. -->
    <filter id="edge-rough" x="-35%" y="-35%" width="170%" height="170%">
      <feTurbulence type="fractalNoise" baseFrequency="0.018 0.026" numOctaves="3" seed="4" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="11" xChannelSelector="R" yChannelSelector="G"/>
    </filter>

    <!-- Halftone-ish dot pattern for accents/dividers -->
    <pattern id="halftone" x="0" y="0" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.1" fill="currentColor"/>
    </pattern>
  </defs>
</svg>
