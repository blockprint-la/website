---
// Minimal pre-launch holding page. Wordmark + custom SMS capture form
// wired to Hive's JS SDK (brand ID 135484). Submitters land in the
// "Website Signup" segment so the Blockprint cohort stays separable
// from any other activity on this Hive brand account.
//
// Hive enforces a domain whitelist — only requests from approved origins
// will succeed. Currently whitelisted: blockprint.la. Add localhost +
// *.vercel.app via Hive support (email support@hive.co) if you need
// to test locally or on preview deploys.
---

<section
  class="holding min-h-[100svh] flex flex-col items-center justify-center px-5 md:px-10 py-16"
>
  <h1 class="sr-only">Blockprint — August 22, 2026 · Venice, California</h1>

  <img
    src="/brand/wordmark.png"
    alt=""
    width="1010"
    height="152"
    class="w-full max-w-[720px]"
    aria-hidden="true"
  />

  <!-- "A BLOCK PARTY / ABBOT KINNEY BLVD" sub-lockup. Sits tight under
       the wordmark as a paired unit — width-capped to stay visually
       subordinate. -->
  <img
    src="/brand/block-party-abbot-kinney.png"
    alt="A block party on Abbot Kinney Blvd"
    width="545"
    height="73"
    class="mt-4 md:mt-10 w-full max-w-[420px]"
  />

  <!-- Date · city eyebrow. Single dotted row at every breakpoint —
       mobile sits at 12.5px (a 25% bump over the prior 10px) with
       tighter tracking so the row still fits within a 375px viewport.
       flex-wrap stays as a safety net for unusually narrow viewports. -->
  <div
    class="mt-8 md:mt-10 flex flex-row flex-wrap justify-center items-center gap-x-3 md:gap-x-5 lg:gap-x-6 text-[12.5px] md:text-sm uppercase tracking-[0.12em] md:tracking-[0.4em] text-center"
  >
    <span>August 22, 2026</span>
    <span aria-hidden="true" class="opacity-40">·</span>
    <span>Venice, California</span>
  </div>

  <!-- SMS capture form. Submission triggers phoneNumberSignup on Hive,
       then chains addToSegment to tag the fan into the cohort. The TCPA
       compliance copy below the input is mandatory under Hive's docs —
       the act of submitting the form constitutes the explicit opt-in
       passed as didSmsOptIn: true. -->
  <form
    id="hive-signup"
    class="mt-12 md:mt-14 w-full max-w-[420px] flex flex-col items-stretch gap-3"
    novalidate
  >
    <label for="phone" class="sr-only">Mobile number</label>
    <input
      id="phone"
      name="phone"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      required
      placeholder="Mobile number"
      class="w-full bg-transparent border-b border-ink/40 focus:border-ink outline-none px-1 py-3 text-center text-base md:text-lg tracking-wide placeholder:text-ink/40"
    />
    <button
      type="submit"
      class="mt-3 self-center bg-bp-pink text-paper px-7 py-3 text-xs md:text-sm uppercase tracking-[0.3em] font-bold disabled:opacity-50 disabled:cursor-not-allowed"
      style="box-shadow: -3px 3px 0 var(--color-bp-cyan);"
    >
      <span data-label-idle>Get first access</span>
      <span data-label-loading hidden>Sending…</span>
    </button>

    <p
      data-status
      role="status"
      aria-live="polite"
      class="min-h-[1.25rem] text-center text-xs md:text-sm tracking-wide"
    >
    </p>

    <p
      class="mt-2 text-[10px] md:text-xs text-center text-ink/60 leading-relaxed"
    >
      By submitting, you opt in to receive recurring marketing texts from
      Blockprint at the number provided. Msg &amp; data rates may apply.
      Reply STOP to opt out, HELP for help. See our
      <a
        href="/privacy-policy"
        class="underline decoration-ink/40 underline-offset-2 hover:decoration-ink hover:text-ink"
        >Privacy Policy</a
      >.
    </p>
  </form>

  <!-- Social footer. Single Instagram link sits at the bottom of the
       holding section, well separated from the form so it doesn't compete
       with the primary CTA. Tap target is padded to ~44px on every side
       per WCAG / Apple HIG; the visible icon stays compact at 22px so the
       footer reads as a quiet accent rather than a second CTA. -->
  <a
    href="https://www.instagram.com/blockprint.la/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Follow Blockprint on Instagram"
    class="mt-12 md:mt-14 inline-flex items-center gap-2 px-3 py-2 text-[11px] md:text-xs uppercase tracking-[0.25em] text-ink/70 hover:text-ink transition-colors"
  >
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none"
      ></circle>
    </svg>
    <span>@blockprint.la</span>
  </a>
</section>

<!-- Hive SDK loader. is:inline preserves the IIFE so Astro's bundler
     doesn't tree-shake or transform the queueing pattern that lets us
     call HIVE_SDK("init", ...) before the actual SDK has loaded. -->
<script is:inline>
  (function (h, i, v, e, s, d, k) {
    h.HiveSDKObject = s;
    h[s] =
      h[s] ||
      function () {
        (h[s].q = h[s].q || []).push(arguments);
      };
    d = i.createElement(v);
    k = i.getElementsByTagName(v)[0];
    d.async = 1;
    d.id = s;
    d.src = e + "?r=" + parseInt(new Date() / 60000);
    k.parentNode.insertBefore(d, k);
  })(
    window,
    document,
    "script",
    "https://cdn-prod.hive.co/static/js/sdk-loader.js",
    "HIVE_SDK"
  );
  HIVE_SDK("init", 135484);
</script>

<!-- Form submit handler. Inline so it runs in the same global scope as
     the SDK loader above and can call window.HIVE_SDK directly without
     module-import dance. -->
<script is:inline>
  (function () {
    const form = document.getElementById("hive-signup");
    if (!form) return;

    const phoneInput = form.querySelector("#phone");
    const button = form.querySelector("button[type=submit]");
    const labelIdle = button.querySelector("[data-label-idle]");
    const labelLoading = button.querySelector("[data-label-loading]");
    const status = form.querySelector("[data-status]");

    const setLoading = (loading) => {
      button.disabled = loading;
      labelIdle.hidden = loading;
      labelLoading.hidden = !loading;
    };

    const setStatus = (msg, tone) => {
      status.textContent = msg;
      status.style.color =
        tone === "ok"
          ? "var(--color-bp-navy)"
          : tone === "err"
            ? "var(--color-bp-pink-deep)"
            : "";
    };

    const collapseToSuccess = () => {
      phoneInput.disabled = true;
      button.hidden = true;
      setStatus("You're in. We'll text you when tickets drop.", "ok");
    };

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const phone = phoneInput.value.trim();
      if (!phone) {
        setStatus("Please enter your mobile number.", "err");
        phoneInput.focus();
        return;
      }

      setLoading(true);
      setStatus("");

      // Hive parses E.164 / RFC3966 and defaults bad formats to +1 (US/CA),
      // so we pass the raw input and let the SDK normalize.
      window.HIVE_SDK(
        "phoneNumberSignup",
        { phoneNumber: phone, didSmsOptIn: true },
        function () {
          // Signup succeeded — tag into the cohort segment. We treat the
          // signup as the source of truth: if addToSegment fails, the fan
          // is still subscribed, so we surface success and just log the
          // tagging error for later cleanup.
          window.HIVE_SDK(
            "addToSegment",
            "Website Signup",
            collapseToSuccess,
            function (err) {
              console.error("[hive] addToSegment failed", err);
              collapseToSuccess();
            }
          );
        },
        function (err) {
          console.error("[hive] phoneNumberSignup failed", err);
          setStatus("Could not subscribe — please try again.", "err");
          setLoading(false);
        }
      );
    });
  })();
</script>
