---
import { site } from "../data/site";
---

<section id="tickets" class="relative px-5 md:px-10 py-24 md:py-32 bg-bp-cyan text-ink overflow-hidden">
  <!-- Halftone wash on the right edge — pink dot pattern over the cyan field -->
  <svg class="absolute -right-10 top-0 bottom-0 w-1/2 opacity-25 pointer-events-none" aria-hidden="true">
    <rect width="100%" height="100%" fill="url(#halftone)" style="color: var(--color-bp-pink)"></rect>
  </svg>

  <div class="relative max-w-5xl mx-auto text-center">
    <p class="section-marker section-marker--ink mb-4">Now on Sale</p>
    <h2
      class="block-print font-[var(--font-display)] uppercase font-black leading-[0.85] text-[clamp(3rem,12vw,10rem)]"
      data-ink="ink"
      data-ghost
      style="--ghost: var(--color-bp-pink);"
    >
      Get Tickets
    </h2>

    <p class="mt-6 text-base md:text-lg uppercase tracking-[0.25em]">
      {site.dateShort} · {site.venue} · {site.agePolicy}
    </p>

    <a
      href={site.ticketUrl}
      class="group inline-flex items-center gap-3 mt-10 bg-ink text-paper px-10 py-5 text-base md:text-lg uppercase tracking-[0.25em] font-bold"
      style="box-shadow: -4px 4px 0 var(--color-bp-pink); filter: url(#ink-bleed-soft);"
    >
      Buy on Tixr
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
    </a>

    <p class="mt-6 text-xs uppercase tracking-[0.3em] opacity-80">
      Tier pricing announced soon
    </p>
  </div>
</section>
