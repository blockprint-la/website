---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="relative px-5 md:px-10 py-16 border-t-[2px] border-ink/30">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-end justify-between gap-10">
    <div>
      <a href="#top" class="block w-fit">
        <img src="/brand/workdmark-footer.png" alt="Blockprint" class="block max-w-none w-[22rem] md:w-[29rem] h-auto -mt-9 -mb-[25px] -ml-10 md:-mt-12 md:-mb-[37px] md:-ml-[52px]" />
      </a>
      <p class="text-xs uppercase tracking-[0.3em] opacity-70">
        {site.dateShort} · {site.venue} · {site.city}
      </p>
    </div>

    <div class="flex flex-col md:items-end gap-3 text-sm">
      <div class="flex flex-wrap gap-5 uppercase tracking-[0.2em] text-xs">
        {site.social.instagram && <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-bp-pink">Instagram</a>}
        {site.social.tiktok && <a href={site.social.tiktok} target="_blank" rel="noopener noreferrer" class="hover:text-bp-pink">TikTok</a>}
        {site.social.spotify && <a href={site.social.spotify} target="_blank" rel="noopener noreferrer" class="hover:text-bp-pink">Spotify</a>}
        <a href={`mailto:${site.contactEmail}`} class="hover:text-bp-pink">Contact</a>
        <a href={`mailto:${site.pressEmail}`} class="hover:text-bp-pink">Press</a>
      </div>
      <p class="text-xs opacity-60 uppercase tracking-[0.2em]">
        © {year} Blockprint · {site.domain}
      </p>
    </div>
  </div>
</footer>
