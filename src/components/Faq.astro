---
import { faqs } from "../data/site";
---

<section id="faq" class="relative px-5 md:px-10 py-24 md:py-32 bg-paper-deep">
  <div class="max-w-4xl mx-auto">
    <p class="section-marker mb-4">Questions</p>
    <h2
      class="block-print font-[var(--font-display)] uppercase font-black leading-[0.85] text-[clamp(2.5rem,8vw,6rem)] mb-12"
      data-ink="pink"
      data-ghost
      style="--ghost: var(--color-bp-cyan);"
    >
      FAQ
    </h2>

    <ul class="divide-y-[2px] divide-ink/30 border-y-[2px] border-ink/30">
      {faqs.map((f) => (
        <li>
          <details class="group py-5 md:py-6">
            <summary class="flex items-center justify-between gap-6 cursor-pointer list-none">
              <span class="font-[var(--font-display)] text-xl md:text-3xl uppercase font-black leading-tight">
                {f.q}
              </span>
              <span
                aria-hidden="true"
                class="shrink-0 w-8 h-8 md:w-10 md:h-10 flex items-center justify-center text-bp-pink text-2xl md:text-3xl font-bold transition-transform group-open:rotate-45"
              >+</span>
            </summary>
            <p class="mt-4 text-base md:text-lg leading-relaxed opacity-90 max-w-3xl">
              {f.a}
            </p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>
