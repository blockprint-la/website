---
import { site } from "../data/site";
---

<section
  id="top"
  class="hero relative min-h-[100svh] flex flex-col items-center px-5 md:px-10 pt-24 md:pt-32 pb-16 overflow-hidden"
>
  <!-- Marginalia: pink seagulls drifting in opposite margins of the hero.
       Source PNG was split into two single-bird files so each can sit at
       its own viewport-edge anchor and drift with its own rhythm. -->
  <!-- Anchored at fixed pixel distances from viewport center, not from the
       edges. As the window narrows the centerline moves toward each bird's
       absolute position, eventually pushing them past the viewport edge —
       so they naturally fly out of frame on smaller screens, clipped by
       the section's overflow-hidden. No breakpoint hide needed. -->
  <img
    src="/brand/bird-left.png"
    alt=""
    width="156"
    height="74"
    class="hero-bird-l pointer-events-none select-none absolute top-[32%] left-[calc(50%-770px)] w-[150px] z-0 opacity-90 will-change-transform"
    aria-hidden="true"
  />
  <img
    src="/brand/bird-right.png"
    alt=""
    width="185"
    height="81"
    class="hero-bird-r pointer-events-none select-none absolute top-[46%] right-[calc(50%-770px)] w-[180px] z-0 opacity-90 will-change-transform"
    aria-hidden="true"
  />
  <img
    src="/brand/BIRDS - ALT.png"
    alt=""
    width="189"
    height="129"
    class="hero-bird-l pointer-events-none select-none absolute top-[18%] right-[calc(50%-720px)] w-[120px] z-0 opacity-90 will-change-transform"
    aria-hidden="true"
  />
  <img
    src="/brand/BIRDS - ALT 3.png"
    alt=""
    width="255"
    height="51"
    class="hero-bird-r pointer-events-none select-none absolute top-[62%] left-[calc(50%-700px)] w-[90px] z-0 opacity-80 will-change-transform"
    aria-hidden="true"
  />

  <h1 class="sr-only">Blockprint</h1>

  <!-- POSTER COLUMN — the entire hero lockup lives inside one centered,
       width-capped column so the wordmark, lineup, and collage all share a
       single width and stack as one poster at every size. Desktop is simply
       a scaled-up version of the mobile composition (the look we're matching)
       rather than each element sprawling to its own max-width. Sub-elements
       are sized as a PERCENTAGE of this column so their proportions hold
       across breakpoints. Birds stay anchored to the section, so they keep
       drifting in the margins around this column. -->
  <div class="relative z-10 w-full max-w-[700px] mx-auto flex flex-col items-center">
    <!-- Hero wordmark — the BLOCKPRINT logotype, custom-cut letterforms -->
    <img
      src="/brand/wordmark-2026.png"
      alt=""
      width="1016"
      height="148"
      class="hero-stamp w-full"
      aria-hidden="true"
    />

    <!-- "A BLOCK PARTY / ABBOT KINNEY BLVD" lockup — sits below the wordmark.
         Replaces the old "Presented by Mudwatr" line (Mudwatr removed). -->
    <img
      src="/brand/block-party-lockup.png"
      alt="A block party on Abbot Kinney Blvd"
      width="545"
      height="73"
      class="hero-print w-[86%] mt-4 md:mt-6"
      style="animation-delay: 0.25s;"
    />

    <!-- "A — Z" tracker — sits directly above the lineup -->
    <img
      src="/brand/az-tracker.png"
      alt=""
      width="130"
      height="21"
      class="hero-print w-[18%] mt-6 md:mt-8 mb-1 md:mb-2"
      style="animation-delay: 0.4s;"
      aria-hidden="true"
    />

    <!-- Lineup lockup + flanking stamps. MUSIC ARTS EATS and AUG 22 are
         anchored RELATIVE to this wrapper. On desktop they drift into the
         side margins; on mobile/tablet they tuck beside the top row (no
         margin to drift into). Both stamps carry their rotation baked in. -->
    <div
      class="hero-line relative w-full mt-2 md:mt-3"
      style="animation-delay: 0.35s;"
    >
      <img
        src="/brand/lineup-2026.png"
        alt="Darius, Eli & Fur, Franc Moody (DJ Set), Luxxury, Sosh & Mosh"
        width="959"
        height="481"
        class="relative z-10 w-full"
      />

      <!-- MUSIC · ARTS · EATS — upper-left flank (rotation baked into PNG) -->
      <img
        src="/brand/music-arts-eats.png"
        alt="Music · Arts · Eats"
        width="187"
        height="178"
        class="hero-print absolute z-20 w-[74px] lg:w-[128px] top-[-7%] left-[-1%] lg:top-[-9%] lg:left-[-17%]"
        style="animation-delay: 0.7s;"
      />

      <!-- AUG 22 — right flank (rotation baked into PNG) -->
      <img
        src="/brand/aug-22.png"
        alt="August 22"
        width="134"
        height="107"
        class="hero-print absolute z-20 w-[60px] lg:w-[116px] top-[2%] right-[-1%] lg:top-[28%] lg:right-[-15%]"
        style="animation-delay: 0.85s;"
      />
    </div>
  </div>

  <!-- Date / venue / age (text-only, sr-only — image alts cover the visual) -->
  <p class="sr-only">{site.date} · {site.venue}, {site.city} · {site.agePolicy}</p>

  <!-- Venue collage. Full-bleed edge-to-edge on mobile (the look Jake
       liked); contained to the poster column on desktop so it reads as part
       of the poster instead of detaching across the whole viewport. -->
  <img
    src="/brand/collage.png"
    alt=""
    width="1008"
    height="439"
    class="hero-print relative z-10 block mt-3 md:mt-5 w-screen max-w-none -mx-5 md:w-full md:max-w-[700px] md:mx-auto"
    style="animation-delay: 1s;"
    aria-hidden="true"
  />

  <!-- CTA -->
  <div class="hero-print relative z-10 mt-10 md:mt-12" style="animation-delay: 1.15s;">
    <a
      href={site.ticketUrl}
      class="group inline-flex items-center gap-3 bg-bp-pink text-paper px-8 py-4 text-sm md:text-base uppercase tracking-[0.25em] font-bold"
      style="filter: url(#ink-bleed-soft); box-shadow: -4px 4px 0 var(--color-bp-cyan);"
    >
      Buy Tickets
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
    </a>
    <p class="mt-4 text-xs uppercase tracking-[0.3em] text-center opacity-75">
      {site.agePolicy} · 3–9 PM · {site.city}
    </p>
  </div>
</section>

<!--
  Pure-CSS entrance animations live in global.css:
    .hero-stamp  (stamp-press)  — wordmark dramatic entrance
    .hero-line   (stamp-line)   — headliners slide-up
    .hero-tag    (fade-in, preserves rotation)  — date / venue tags
    .hero-print  (fade-up)      — generic stamped element
    .hero-birds  (gull-drift)   — continuous loop
-->

<script>
  // Parallax lift for the hero birds. Lenis smooth scroll suppresses native
  // `scroll` events, but `window.scrollY` updates each Lenis frame — so an
  // rAF poll picks up changes (mirrors the Nav.astro pattern). The value is
  // written to --bird-y on :root and consumed by the bird drift keyframes,
  // so the parallax composes with the existing drift instead of overriding
  // its transform.
  const BIRD_FACTOR = 0.3;
  const root = document.documentElement;
  let lastY = -1;
  const tick = () => {
    const y = window.scrollY;
    if (y !== lastY) {
      root.style.setProperty("--bird-y", `${-y * BIRD_FACTOR}px`);
      lastY = y;
    }
    requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
</script>
