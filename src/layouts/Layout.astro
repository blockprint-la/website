---
import "../styles/global.css";
import SvgFilters from "../components/SvgFilters.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.dateShort} · ${site.venue}`,
  description = `${site.name} — a block party on ${site.venue} in ${site.city}. ${site.date}.`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Favicon stack. Modern browsers prefer the SVG; PNGs cover most
         everything else; ICO is the legacy catch-all; apple-touch-icon
         lights up iOS home-screen and macOS Safari pinned tabs. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbf5ee" />

    <!-- OG / social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://www.${site.domain}`} />
    <meta property="og:image" content={`https://www.${site.domain}/og-default.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Blockprint" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`https://www.${site.domain}/og-default.jpg`} />

    <!-- Brand fonts.
         Display: New Edge 666 (custom). Outfit loaded as a free fallback with
         similar geometric construction — drop a New Edge 666 webfont into
         /public/fonts and register @font-face to upgrade.
         Body: Helvetica from system stack — no webfont load needed.
         Accent: Averia Serif Libre per brand book p14. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:wght@400;700&family=Outfit:wght@200;300;400;500;700;900&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Analytics 4. Loaded async so it never blocks render.
         is:inline preserves the gtag queueing pattern (calls before the
         remote script finishes loading buffer into dataLayer). -->
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4MeasurementId}`}
    ></script>
    <script is:inline define:vars={{ measurementId: site.ga4MeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", measurementId);
    </script>

    <!-- Meta Pixel. is:inline so Astro doesn't transform the IIFE that
         injects fbevents.js. The PageView fires on every page load;
         additional standard/custom events can be added later via
         fbq('track', ...) calls from page-specific scripts. -->
    <script is:inline define:vars={{ pixelId: site.metaPixelId }}>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js"
      );
      fbq("init", pixelId);
      fbq("track", "PageView");
    </script>
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${site.metaPixelId}&ev=PageView&noscript=1`}
      /></noscript>
  </head>

  <body>
    <SvgFilters />
    <main>
      <slot />
    </main>

    <!-- Lenis smooth scroll -->
    <script>
      import Lenis from "lenis";
      const lenis = new Lenis({
        duration: 1.1,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Anchor links — let Lenis handle the scroll instead of native jump
      document.addEventListener("click", (e) => {
        const a = (e.target as HTMLElement)?.closest("a[href^='#']");
        if (!a) return;
        const href = a.getAttribute("href");
        if (!href || href === "#") return;
        const el = document.querySelector(href);
        if (!el) return;
        e.preventDefault();
        lenis.scrollTo(el as HTMLElement, { offset: -8 });
      });

      // Scroll reveals: only ARM elements that are below the fold on initial load.
      // Above-the-fold or already-in-view elements stay visible immediately —
      // no risk of being stranded at opacity 0 if scripts are slow.
      const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const vh = window.innerHeight;
      reveals.forEach((el) => {
        const rect = el.getBoundingClientRect();
        if (rect.top > vh * 0.85) {
          el.setAttribute("data-reveal-armed", "");
        }
      });
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
      );
      reveals.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
